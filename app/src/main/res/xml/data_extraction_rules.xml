<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Room history contains personal PC telemetry; do not back it up. -->
        <exclude domain="file" path="databases/"/>
        <!-- Settings hold the server auth token; do not back it up. -->
        <exclude domain="file" path="settings.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="databases/"/>
        <exclude domain="file" path="settings.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>